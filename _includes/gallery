{% include base_path %}

{% if include.id %}
  {% assign gallery = page.[include.id] %}
{% else %}
  {% assign gallery = page.gallery %}
{% endif %}

{% comment %}
  Use a two-column gallery by default. Individual images can opt into a
  full-width row with `layout: full` or preserve their complete frame with
  `fit: contain` in the page front matter.
{% endcomment %}
{% assign gallery_layout = 'half' %}

<figure class="project-gallery {{ gallery_layout }} {{ include.class }}">
  {% for img in gallery %}
    {% capture img_url %}
      {% if img.image_path contains "://" %}
        {{ img.image_path }}
      {% else %}
        {{ img.image_path | prepend: "/images/" | prepend: base_path }}
      {% endif %}
    {% endcapture %}
    
    {% if img.url %}
      <a class="gallery-item{% if img.layout == 'full' %} gallery-item--full{% endif %}" href=
        {% if img.url contains "://" %}
          "{{ img.url }}"
        {% else %}
          "{{ img.url | prepend: "/images/" | prepend: base_path }}"
        {% endif %}
        {% if img.title %}title="{{ img.title }}"{% endif %}
      >
        <img src="{{ img_url | strip }}" alt="{{ img.alt | default: page.title }}" class="gallery-image{% if img.fit == 'contain' or img.layout == 'full' %} gallery-image--contain{% endif %}" loading="lazy" decoding="async">
      </a>
    {% else %}
      <a class="gallery-item{% if img.layout == 'full' %} gallery-item--full{% endif %}" href="{{ img_url | strip }}" data-lightbox="gallery" {% if img.title %}data-title="{{ img.title }}"{% endif %}>
        <img src="{{ img_url | strip }}" alt="{{ img.alt | default: page.title }}" class="gallery-image{% if img.fit == 'contain' or img.layout == 'full' %} gallery-image--contain{% endif %}" loading="lazy" decoding="async">
      </a>
    {% endif %}
  {% endfor %}
  {% if include.caption %}
    <figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>
  {% endif %}
</figure>
